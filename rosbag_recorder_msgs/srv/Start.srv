# Start recording. An empty profile uses the selected one. force skips the start condition.
string profile
string label
string notes
bool force
# MCAP storage preset (none, fastwrite, zstd_fast, zstd_small); empty keeps the profile's.
# It stays on the selection until a profile or topics are selected again.
string storage_preset
---
bool success
string message
string session_id
CheckResult[] preflight
